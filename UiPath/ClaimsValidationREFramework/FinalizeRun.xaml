    <ui:InvokeCode DisplayName="Build reconciliation workbook" Language="CSharp" Code="end = DateTime.UtcNow;&#10;var rows = details.AsEnumerable().ToList();&#10;var last = rows.GroupBy(r =&gt; r[&quot;ClaimID&quot;].ToString()).Select(g =&gt; g.Last()).ToList();&#10;int Count(string s) { return last.Count(r =&gt; r[&quot;Outcome&quot;].ToString() == s); }&#10;metrics = new Dictionary&lt;string,object&gt; { {&quot;TotalClaims&quot;,last.Count},{&quot;Approved&quot;,Count(&quot;APPROVED&quot;)},{&quot;Rejected&quot;,Count(&quot;REJECTED&quot;)},{&quot;Failed&quot;,Count(&quot;ERROR&quot;)},{&quot;Skipped&quot;,Count(&quot;SKIPPED&quot;)},{&quot;Attempts&quot;,rows.Count},{&quot;Retries&quot;,rows.Count(r =&gt; Convert.ToInt32(r[&quot;RetryNumber&quot;]) &gt; 0)},{&quot;ErrorAttempts&quot;,rows.Count(r =&gt; r[&quot;Outcome&quot;].ToString() == &quot;ERROR&quot;)} };&#10;status = !string.IsNullOrEmpty(fatal) ? &quot;Failed&quot; : stopped ? &quot;Stopped&quot; : Count(&quot;ERROR&quot;) &gt; 0 ? &quot;CompletedWithErrors&quot; : &quot;Completed&quot;;&#10;error = &quot;&quot;; path = &quot;&quot;;&#10;try {&#10; var folder = config != null &amp;&amp; config.ContainsKey(&quot;ReportFolder&quot;) ? config[&quot;ReportFolder&quot;].ToString() : System.IO.Path.Combine(System.IO.Path.GetDirectoryName(config[&quot;ClaimsFilePath&quot;].ToString()),&quot;Reports&quot;);&#10; System.IO.Directory.CreateDirectory(folder);&#10; path = System.IO.Path.Combine(folder,&quot;Claims_&quot;+start.ToString(&quot;yyyyMMdd_HHmmss&quot;)+&quot;_&quot;+key.Substring(0,8)+&quot;.xlsx&quot;);&#10; using (var book = new ClosedXML.Excel.XLWorkbook()) {&#10;  var summary = book.Worksheets.Add(&quot;Summary&quot;);summary.Cell(1,1).Value=&quot;Metric&quot;;summary.Cell(1,2).Value=&quot;Value&quot;;&#10;  summary.Cell(2,1).Value=&quot;Run ID&quot;;summary.Cell(2,2).Value=key;&#10;  summary.Cell(3,1).Value=&quot;Started (UTC)&quot;;summary.Cell(3,2).Value=start;summary.Cell(3,2).Style.DateFormat.Format=&quot;yyyy-mm-dd hh:mm:ss&quot;;&#10;  summary.Cell(4,1).Value=&quot;Ended (UTC)&quot;;summary.Cell(4,2).Value=end;summary.Cell(4,2).Style.DateFormat.Format=&quot;yyyy-mm-dd hh:mm:ss&quot;;&#10;  summary.Cell(5,1).Value=&quot;Run status&quot;;summary.Cell(5,2).Value=status;&#10;  int row=6;foreach(var pair in metrics){summary.Cell(row,1).Value=pair.Key;summary.Cell(row++,2).Value=Convert.ToInt32(pair.Value);}&#10;  summary.Cell(row,1).Value=&quot;Reconciliation&quot;;summary.Cell(row++,2).FormulaA1=&quot;B6-SUM(B7:B10)&quot;;&#10;  summary.Cell(row,1).Value=&quot;Counting rule&quot;;summary.Cell(row++,2).Value=&quot;Totals use the last outcome per ClaimID. Attempts, errors and retries count every attempt in this run.&quot;;&#10;  summary.Cell(row,1).Value=&quot;Fatal error&quot;;summary.Cell(row,2).Value=fatal ?? &quot;&quot;;&#10;  summary.Column(1).Width=25;summary.Column(2).Width=75;summary.Column(2).Style.Alignment.WrapText=true;&#10;  summary.Row(row-1).Height=45;&#10;  var detail=book.Worksheets.Add(&quot;Details&quot;);&#10;  for(int col=0;col&lt;details.Columns.Count;col++)detail.Cell(1,col+1).Value=details.Columns[col].ColumnName;&#10;  if(details.Rows.Count&gt;0)detail.Cell(2,1).InsertData(details.Rows);&#10;  detail.Columns().AdjustToContents();detail.Column(1).Width=23;detail.Column(9).Width=65;detail.Column(9).Style.Alignment.WrapText=true;detail.Column(1).Style.DateFormat.Format=&quot;yyyy-mm-dd hh:mm:ss&quot;;&#10;  detail.SheetView.FreezeRows(1);detail.Range(1,1,Math.Max(1,details.Rows.Count+1),details.Columns.Count).SetAutoFilter();&#10;  foreach(var sheet in book.Worksheets){sheet.Style.Font.FontName=&quot;Calibri&quot;;sheet.Style.Font.FontSize=11;sheet.Row(1).Style.Font.Bold=true;sheet.Row(1).Style.Fill.BackgroundColor=ClosedXML.Excel.XLColor.LightBlue;}&#10;  book.SaveAs(path, false, true);&#10; }&#10;} catch(Exception ex) {error=ex.Message;status=&quot;ReportingFailed&quot;;path=&quot;&quot;;}">
