  <Sequence DisplayName="Process">
    <Sequence.Variables>
      <Variable Name="claim" x:TypeArguments="cc:Claim"/>
      <Variable Name="claimStatus" x:TypeArguments="x:String"/>
      <Variable Name="claimReason" x:TypeArguments="x:String"/>
      <Variable Name="alreadyProcessed" x:TypeArguments="x:Boolean"/>
      <Variable Name="claimRow" x:TypeArguments="sd:DataRow"/>
    </Sequence.Variables>
    <ui:InvokeCode DisplayName="Map claim data" Language="CSharp" Code="var table = new System.Data.DataTable();&#10;foreach (var key in new [] {&quot;ClaimID&quot;,&quot;MemberID&quot;,&quot;ProviderID&quot;,&quot;ServiceDate&quot;,&quot;Amount&quot;,&quot;ServiceType&quot;}) table.Columns.Add(key, typeof(object));&#10;row = table.NewRow();&#10;foreach (System.Data.DataColumn col in table.Columns) row[col.ColumnName] = item.SpecificContent.ContainsKey(col.ColumnName) ? item.SpecificContent[col.ColumnName] ?? DBNull.Value : DBNull.Value;&#10;table.Rows.Add(row);">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="ui:QueueItem" x:Key="item">
          <CSharpValue x:TypeArguments="ui:QueueItem">in_TransactionItem</CSharpValue>
        </InArgument>
        <OutArgument x:TypeArguments="sd:DataRow" x:Key="row">
          <CSharpReference x:TypeArguments="sd:DataRow">claimRow</CSharpReference>
        </OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:LogMessage DisplayName="Log claim result" Level="Info">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <CSharpValue x:TypeArguments="x:Object">"Processing claim: " + claimRow["ClaimID"].ToString()</CSharpValue>
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <ui:InvokeWorkflowFile DisplayName="Invoke ValidateClaim" WorkflowFileName="ValidateClaim.xaml" UnSafe="False">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="sd:DataRow" x:Key="inRow">
          <CSharpValue x:TypeArguments="sd:DataRow">claimRow</CSharpValue>
        </InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="inMembers">
          <CSharpValue x:TypeArguments="sd:DataTable">in_dtMembers</CSharpValue>
        </InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="inProviders">
          <CSharpValue x:TypeArguments="sd:DataTable">in_dtProviders</CSharpValue>
        </InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="inLimits">
          <CSharpValue x:TypeArguments="sd:DataTable">in_dtCoverageLimits</CSharpValue>
        </InArgument>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="inProcessed">
          <CSharpValue x:TypeArguments="sd:DataTable">io_dtProcessedClaims</CSharpValue>
        </InArgument>
        <OutArgument x:TypeArguments="cc:Claim" x:Key="outClaim">
          <CSharpReference x:TypeArguments="cc:Claim">claim</CSharpReference>
        </OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="outStatus">
          <CSharpReference x:TypeArguments="x:String">claimStatus</CSharpReference>
        </OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="outReason">
          <CSharpReference x:TypeArguments="x:String">claimReason</CSharpReference>
        </OutArgument>
        <OutArgument x:TypeArguments="x:Boolean" x:Key="outAlreadyProcessed">
          <CSharpReference x:TypeArguments="x:Boolean">alreadyProcessed</CSharpReference>
        </OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <If>
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <CSharpValue x:TypeArguments="x:Boolean">alreadyProcessed</CSharpValue>
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Reuse saved decision">
          <ui:LogMessage DisplayName="Log claim result" Level="Info">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <CSharpValue x:TypeArguments="x:Object">claim.ClaimId + " | SKIPPED | Already saved in the database"</CSharpValue>
              </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
          <If>
            <If.Condition>
              <InArgument x:TypeArguments="x:Boolean">
                <CSharpValue x:TypeArguments="x:Boolean">io_dtProcessedClaims.AsEnumerable().Any(r =&gt; r["ClaimID"].ToString() == claim.ClaimId &amp;&amp; r["Status"].ToString() == "REJECTED")</CSharpValue>
              </InArgument>
            </If.Condition>
            <If.Then>
              <Throw>
                <Throw.Exception>
                  <InArgument x:TypeArguments="s:Exception">
                    <CSharpValue x:TypeArguments="s:Exception">new UiPath.Core.BusinessRuleException(io_dtProcessedClaims.AsEnumerable().First(r =&gt; r["ClaimID"].ToString() == claim.ClaimId)["ReasonCode"].ToString())</CSharpValue>
                  </InArgument>
                </Throw.Exception>
              </Throw>
            </If.Then>
          </If>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Save new claim result">
          <ui:InvokeWorkflowFile DisplayName="Invoke SaveClaim" WorkflowFileName="SaveClaim.xaml" UnSafe="False">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="cc:Claim" x:Key="in_Claim">
                <CSharpValue x:TypeArguments="cc:Claim">claim</CSharpValue>
              </InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Status">
                <CSharpValue x:TypeArguments="x:String">claimStatus</CSharpValue>
              </InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Reason">
                <CSharpValue x:TypeArguments="x:String">claimReason</CSharpValue>
              </InArgument>
              <InArgument x:TypeArguments="ui:DatabaseConnection" x:Key="in_dbConnection">
                <CSharpValue x:TypeArguments="ui:DatabaseConnection">in_dbConnection</CSharpValue>
              </InArgument>
              <InOutArgument x:TypeArguments="sd:DataTable" x:Key="io_dtProcessedClaims">
                <CSharpReference x:TypeArguments="sd:DataTable">io_dtProcessedClaims</CSharpReference>
              </InOutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <ui:LogMessage DisplayName="Log claim result" Level="Info">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <CSharpValue x:TypeArguments="x:Object">claim.ClaimId + " | " + claimStatus + (string.IsNullOrWhiteSpace(claimReason) ? "" : " | " + claimReason)</CSharpValue>
              </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
          <If>
            <If.Condition>
              <InArgument x:TypeArguments="x:Boolean">
                <CSharpValue x:TypeArguments="x:Boolean">claimStatus == "REJECTED"</CSharpValue>
              </InArgument>
            </If.Condition>
            <If.Then>
              <Throw>
                <Throw.Exception>
                  <InArgument x:TypeArguments="s:Exception">
                    <CSharpValue x:TypeArguments="s:Exception">new UiPath.Core.BusinessRuleException(claimReason)</CSharpValue>
                  </InArgument>
                </Throw.Exception>
              </Throw>
            </If.Then>
          </If>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
