  <Sequence DisplayName="ValidateClaim">
    <ui:InvokeCode Code="// Convert the Excel row into our Claim object.&#10;outClaim = new ClaimsValidation.Core.Claim{&#10;    ClaimId = ClaimsValidation.Core.IdNormalizer.Normalize(&#10;        inRow[&quot;ClaimID&quot;].ToString()),&#10;    MemberId = ClaimsValidation.Core.IdNormalizer.Normalize(&#10;        inRow[&quot;MemberID&quot;].ToString()),&#10;    ProviderId = ClaimsValidation.Core.IdNormalizer.Normalize(&#10;        inRow[&quot;ProviderID&quot;].ToString()),&#10;    ServiceType = ClaimsValidation.Core.IdNormalizer.Normalize(&#10;        inRow[&quot;ServiceType&quot;].ToString()),&#10;    Amount = System.Convert.ToDecimal(inRow[&quot;Amount&quot;])&#10;};&#10;&#10;// Excel dates can arrive as a DateTime or an Excel serial number.&#10;object dateValue = inRow[&quot;ServiceDate&quot;];&#10;&#10;if (dateValue is System.DateTime){&#10;    outClaim.ServiceDate = ((System.DateTime)dateValue).Date;&#10;}&#10;else if (dateValue is double){&#10;    outClaim.ServiceDate =&#10;        System.DateTime.FromOADate((double)dateValue).Date;&#10;}&#10;else{&#10;    outClaim.ServiceDate =&#10;        System.Convert.ToDateTime(dateValue).Date;&#10;}&#10;&#10;// Reset outputs for this claim.&#10;outAlreadyProcessed = false;&#10;outStatus = &quot;&quot;;&#10;outReason = &quot;&quot;;&#10;&#10;var reasons = new System.Collections.Generic.List&lt;string&gt;();&#10;&#10;// Check saved ClaimIDs and matching claim details.&#10;foreach (System.Data.DataRow saved in inProcessed.Rows){&#10;    string savedClaimId =&#10;        ClaimsValidation.Core.IdNormalizer.Normalize(&#10;            saved[&quot;ClaimID&quot;].ToString());&#10;&#10;    if (savedClaimId == outClaim.ClaimId){&#10;        outAlreadyProcessed = true;&#10;    }&#10;&#10;    bool sameDetails =&#10;        ClaimsValidation.Core.IdNormalizer.Normalize(&#10;            saved[&quot;MemberID&quot;].ToString()) == outClaim.MemberId&#10;        &amp;&amp; ClaimsValidation.Core.IdNormalizer.Normalize(&#10;            saved[&quot;ProviderID&quot;].ToString()) == outClaim.ProviderId&#10;        &amp;&amp; System.Convert.ToDateTime(saved[&quot;ServiceDate&quot;]).Date&#10;            == outClaim.ServiceDate.Date&#10;        &amp;&amp; System.Convert.ToDecimal(saved[&quot;Amount&quot;])&#10;            == outClaim.Amount;&#10;&#10;    if (sameDetails){&#10;        reasons.Add(&quot;DUPLICATE_CLAIM&quot;);&#10;    }&#10;}&#10;&#10;if (outAlreadyProcessed){&#10;    // Do not insert the same primary key again.&#10;    outStatus = &quot;SKIPPED&quot;;&#10;    outReason = &quot;ALREADY_PROCESSED&quot;;&#10;}&#10;else{&#10;    // Check required text fields.&#10;    if (string.IsNullOrWhiteSpace(outClaim.ClaimId)){&#10;        reasons.Add(&quot;MISSING_CLAIM_ID&quot;);&#10;    }&#10;&#10;    if (string.IsNullOrWhiteSpace(outClaim.MemberId)){&#10;        reasons.Add(&quot;MISSING_MEMBER_ID&quot;);&#10;    }&#10;&#10;    if (string.IsNullOrWhiteSpace(outClaim.ProviderId)){&#10;        reasons.Add(&quot;MISSING_PROVIDER_ID&quot;);&#10;    }&#10;&#10;    if (string.IsNullOrWhiteSpace(outClaim.ServiceType)){&#10;        reasons.Add(&quot;MISSING_SERVICE_TYPE&quot;);&#10;    }&#10;&#10;    if (outClaim.Amount &lt;= 0){&#10;        reasons.Add(&quot;INVALID_AMOUNT&quot;);&#10;    }&#10;&#10;    // Find the member.&#10;    System.Data.DataRow memberRow = null;&#10;&#10;    foreach (System.Data.DataRow candidate in inMembers.Rows){&#10;        string memberId =&#10;            ClaimsValidation.Core.IdNormalizer.Normalize(&#10;                candidate[&quot;MemberID&quot;].ToString());&#10;&#10;        if (memberId == outClaim.MemberId){&#10;            memberRow = candidate;&#10;            break;&#10;        }&#10;    }&#10;&#10;    if (memberRow == null&#10;        &amp;&amp; !string.IsNullOrWhiteSpace(outClaim.MemberId)){&#10;        reasons.Add(&quot;MEMBER_NOT_FOUND&quot;);&#10;    }&#10;&#10;    // Check whether the provider exists.&#10;    bool providerExists = false;&#10;&#10;    foreach (System.Data.DataRow candidate in inProviders.Rows){&#10;        string providerId =&#10;            ClaimsValidation.Core.IdNormalizer.Normalize(&#10;                candidate[&quot;ProviderID&quot;].ToString());&#10;&#10;        if (providerId == outClaim.ProviderId){&#10;            providerExists = true;&#10;            break;&#10;        }&#10;    }&#10;&#10;    if (!providerExists&#10;        &amp;&amp; !string.IsNullOrWhiteSpace(outClaim.ProviderId)){&#10;        reasons.Add(&quot;PROVIDER_NOT_FOUND&quot;);&#10;    }&#10;&#10;    // Find the limit for this member's plan and service.&#10;    if (memberRow != null){&#10;        var member = new ClaimsValidation.Core.Member{&#10;            MemberId = outClaim.MemberId,&#10;            CoverageStart = System.Convert.ToDateTime(&#10;                memberRow[&quot;CoverageStart&quot;]),&#10;            CoverageEnd = System.Convert.ToDateTime(&#10;                memberRow[&quot;CoverageEnd&quot;]),&#10;            PlanType = memberRow[&quot;PlanType&quot;].ToString()&#10;        };&#10;&#10;        System.Data.DataRow limitRow = null;&#10;&#10;        foreach (System.Data.DataRow candidate in inLimits.Rows){&#10;            bool samePlan =&#10;                ClaimsValidation.Core.IdNormalizer.Normalize(&#10;                    candidate[&quot;PlanType&quot;].ToString())&#10;                == ClaimsValidation.Core.IdNormalizer.Normalize(&#10;                    member.PlanType);&#10;&#10;            bool sameService =&#10;                ClaimsValidation.Core.IdNormalizer.Normalize(&#10;                    candidate[&quot;ServiceType&quot;].ToString())&#10;                == outClaim.ServiceType;&#10;&#10;            if (samePlan &amp;&amp; sameService){&#10;                limitRow = candidate;&#10;                break;&#10;            }&#10;        }&#10;&#10;        if (limitRow != null){&#10;            decimal limit = System.Convert.ToDecimal(&#10;                limitRow[&quot;MaxAmount&quot;]);&#10;&#10;            var validator =&#10;                new ClaimsValidation.Core.ClaimValidator();&#10;&#10;            var result = validator.Validate(&#10;                outClaim, member, limit);&#10;&#10;            reasons.AddRange(result.Reasons);&#10;        }&#10;        else{&#10;            if (!string.IsNullOrWhiteSpace(outClaim.ServiceType)){&#10;                reasons.Add(&quot;COVERAGE_LIMIT_NOT_FOUND&quot;);&#10;            }&#10;&#10;            // We can still check coverage dates without a limit.&#10;            if (outClaim.ServiceDate.Date &lt; member.CoverageStart.Date&#10;                || outClaim.ServiceDate.Date &gt; member.CoverageEnd.Date){&#10;                reasons.Add(&quot;COVERAGE_INACTIVE&quot;);&#10;            }&#10;        }&#10;    }&#10;&#10;    // Remove repeated reasons and put them in a consistent order.&#10;    var uniqueReasons =&#10;        new System.Collections.Generic.SortedSet&lt;string&gt;(reasons);&#10;&#10;    outReason = string.Join(&quot;, &quot;, uniqueReasons);&#10;    outStatus = uniqueReasons.Count == 0&#10;        ? &quot;APPROVED&quot;&#10;        : &quot;REJECTED&quot;;&#10;}" ContinueOnError="False" DisplayName="Validate current claim" Language="CSharp">
